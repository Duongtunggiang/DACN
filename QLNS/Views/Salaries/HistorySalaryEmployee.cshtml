@model IEnumerable<QLNS.Models.SalaryHistory>

@{
    ViewBag.Title = "HistorySalary";
    var stt = 0;
}

<link href="~/Assets/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lịch sử lương</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            STT
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IdCheck)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Date)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SalaryBase)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.KPI)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DateVacation)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Coe)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Revenue)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Reward)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Result)
                        </th>
                        <th>@Html.DisplayNameFor(model => model.Status)</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    stt++;
                                }
                                @stt
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IdCheck)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SalaryBase)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.KPI)/@Html.DisplayFor(modelItem => item.KPITarget)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DateVacation)/@Html.DisplayFor(modelItem => item.DateVacationTarget)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Coe)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Revenue)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Reward)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Result)
                            </td>
                            <td>
                                Chưa duyệt
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Assets/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Assets/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/Assets/js/demo/datatables-demo.js"></script>
}
