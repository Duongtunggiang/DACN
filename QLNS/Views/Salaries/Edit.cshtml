@model QLNS.Models.Salary

@{
    ViewBag.Title = "Edit";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
<div class="row">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    <div class="col-6">
        @Html.LabelFor(model => model.NameEmployee, htmlAttributes: new { @class = "control-label col-md-12" })
        <div class="col-md-12">
            @Html.EditorFor(model => model.NameEmployee, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.NameEmployee, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-6">
        @Html.LabelFor(model => model.SalaryBase, htmlAttributes: new { @class = "control-label col-md-12" })
        <div class="col-md-12">
            @Html.EditorFor(model => model.SalaryBase, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.SalaryBase, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-6">
        @Html.LabelFor(model => model.KPI, htmlAttributes: new { @class = "control-label col-md-12" })
        <div class="col-md-12">
            @Html.EditorFor(model => model.KPI, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.KPI, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-6">
        @Html.LabelFor(model => model.DateVacation, htmlAttributes: new { @class = "control-label col-md-12" })
        <div class="col-md-12">
            @Html.EditorFor(model => model.DateVacation, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DateVacation, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-6">
        @Html.LabelFor(model => model.IdCheck, htmlAttributes: new { @class = "control-label col-md-12" })
        <div class="col-md-12">
            @Html.EditorFor(model => model.IdCheck, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.IdCheck, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-12 mt-4">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-primary" />
        </div>
    </div>
</div>
}

